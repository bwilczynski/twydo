# Twydo: example vdirsyncer configuration (phase-0 test setup).
# Copy to ~/.config/vdirsyncer/config (outside this repository) and replace the placeholders.
# Run `vdirsyncer discover twydo`, then `vdirsyncer sync twydo` and `vdirsyncer metasync twydo`.

[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair twydo]
a = "twydo_remote"
b = "twydo_local"
collections = ["from a", "from b"]
metadata = ["displayname", "color"]
# `a` is the NAS (CalDAV), `b` the local vdir, so the first discover/sync pulls the NAS collections.
# Deliberately NO conflict_resolution line.
# Spec section 5 forbids `conflict_resolution = "a wins"` / "b wins": either silently discards
# one side, possibly a completion, a recurrence advancement or a deletion. With no setting,
# vdirsyncer reports the conflict as an error and leaves that item untouched while other items
# keep syncing. Plan 3 adds a conflict store that preserves both versions. Until then, phase 0
# only records this default behaviour (docs/phase0/README.md, step 6).

[storage twydo_local]
type = "filesystem"
path = "~/twydo-phase0/vdir/"
fileext = ".ics"

[storage twydo_remote]
type = "caldav"
# Isolated TEST account/collection only, never the production calendar.
url = "https://NAS-HOST/caldav/USERNAME/"
username = "USERNAME"
# No literal secret here: fetch it from a password manager (adjust the command to yours).
password.fetch = ["command", "pass", "show", "twydo-phase0-caldav"]
# Only if the NAS uses a private CA: verify = "/path/to/ca.pem"
